---
import { asset } from '../utils/asset';
import type { Work } from '../types';
import { categoryLabels } from '../types';

interface Props {
  work: Work;
}
const { work } = Astro.props;
---

<li class="card" data-category={work.category}>
  <button class="card-button" type="button" data-open={`work-${work.slug}`} aria-haspopup="dialog">
    {
      work.image ? (
        <span class="card-media">
          <img src={asset(work.image)} alt="" width="1200" height="762" loading="lazy" decoding="async" />
        </span>
      ) : (
        <span class="card-media card-media-private">
          <span class="private-mark" aria-hidden="true">
            &lt;/&gt;
          </span>
          <span class="private-label">非公開案件</span>
        </span>
      )
    }
    <span class="card-body">
      <span class="card-meta">
        <span class="tag">{categoryLabels[work.category]}</span>
        <span class="card-client">{work.client}</span>
      </span>
      <span class="card-title">{work.title}</span>
      <span class="card-summary">{work.summary}</span>
    </span>
  </button>
</li>

<style>
  .card[hidden] {
    display: none;
  }
  .card-button {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .card-media {
    display: block;
    aspect-ratio: 1200 / 762;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--ink-soft);
    outline: 1px solid rgb(23 50 74 / 0.08);
    outline-offset: -1px;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }
  .card-button:hover .card-media img {
    transform: scale(1.03);
  }
  .card-media-private {
    position: relative;
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(135deg, transparent 0 18px, rgb(255 255 255 / 0.04) 18px 19px),
      var(--ink);
    color: var(--paper);
  }
  .private-mark {
    font-family: var(--font-latin);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .private-label {
    position: absolute;
    left: 16px;
    bottom: 12px;
    font-size: 0.8125rem;
    opacity: 0.8;
  }
  .card-body {
    display: grid;
    gap: 6px;
    padding-top: 16px;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .card-client {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink);
  }
  .card-button:hover .card-title {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .card-summary {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--muted);
  }
</style>
