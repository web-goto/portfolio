---
import { asset } from '../utils/asset';
import { shownAiSamples } from '../data/aiSamples';

const isTodo = (text?: string) => !!text && text.startsWith('【記入】');

const steps = [
  { title: 'AIでデザイン案をつくる', body: 'ご要望をもとに、AIで方向性の違うデザイン案をいくつか用意します。' },
  { title: '方向性を選んでいただく', body: '案を見比べて、イメージに近いものを選んでいただきます。' },
  { title: '細部を整える', body: '文字の読みやすさ、余白、ボタンの目立たせ方などを、目で見て調整します。' },
  { title: 'コーディングして公開', body: 'スマホでもPCでも見やすいように組み上げて、公開まで担当します。' },
];
---

{
  shownAiSamples.length > 0 && (
    <section class="section ai" id="ai-design" aria-labelledby="ai-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="ai-title" class="section-title">AIを活用したデザイン</h2>
          <p class="section-lead">
            デザインをゼロから依頼するほどではないけれど、見栄えのいいページがほしい。そんなときは、AIでデザイン案をつくり、細部を整えてからコーディングする方法もあります。デザインにかかる時間を短縮できるので、費用もお手頃です。ここに載せているのは、AIで作成したデザインのサンプルです。
          </p>
        </div>

        <ul class="samples">
          {shownAiSamples.map((s) => (
            <li class="sample">
              <figure>
                {s.image || s.imageMobile ? (
                  <button
                    class:list={['frames', { 'has-mobile': s.image && s.imageMobile, 'mobile-only': !s.image }]}
                    type="button"
                    data-open={`ai-${s.slug}`}
                    aria-haspopup="dialog"
                    aria-label={`${s.title}のデザインを全体表示する`}
                  >
                    {s.image && (
                      <span class="frame-pc">
                        <img src={asset(s.image)} alt="" loading="lazy" />
                      </span>
                    )}
                    {s.imageMobile && (
                      <span class="frame-sp">
                        <img src={asset(s.imageMobile)} alt="" loading="lazy" />
                      </span>
                    )}
                    <span class="frames-hint" aria-hidden="true">全体を見る</span>
                  </button>
                ) : (
                  <div class="frames placeholder">
                    <p>
                      ここにデザイン画像が入ります
                      <br />
                      <small>public/images/ai/ に画像を置いて、aiSamples.ts に書いてね（公開時はこの枠は表示されません）</small>
                    </p>
                  </div>
                )}
                <figcaption class="sample-body">
                  <p class="sample-meta">
                    <span class="tag">{s.genre}</span>
                    自主制作、{s.tool}で作成
                  </p>
                  <p class="sample-title">{s.title}</p>
                  {s.note && <p class:list={['sample-note', { todo: isTodo(s.note) }]}>{s.note}</p>}
                  {s.url && (
                    <a class="sample-link" href={s.url} target="_blank" rel="noopener noreferrer">
                      コーディングしたページを見る
                    </a>
                  )}
                </figcaption>
              </figure>

              {(s.image || s.imageMobile) && (
                <dialog class="viewer" id={`ai-${s.slug}`} aria-labelledby={`ai-${s.slug}-title`}>
                  <div class="viewer-inner" data-view-group>
                    <div class="viewer-head">
                      <p id={`ai-${s.slug}-title`} class="viewer-title">{s.title}</p>
                      {s.image && s.imageMobile && (
                        <div class="viewer-switch" role="group" aria-label="表示を切り替える">
                          <button type="button" data-view="pc" aria-pressed="true">PC</button>
                          <button type="button" data-view="sp" aria-pressed="false">スマホ</button>
                        </div>
                      )}
                      <button class="viewer-close" type="button" data-close aria-label="閉じる">
                        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                      </button>
                    </div>
                    {s.image && (
                      <div class="viewer-body" data-panel="pc">
                        <img class="viewer-pc" src={asset(s.image)} alt={`${s.title}のデザイン（PC表示・全体）`} loading="lazy" />
                      </div>
                    )}
                    {s.imageMobile && (
                      <div class="viewer-body viewer-body-sp" data-panel="sp" hidden={!!s.image}>
                        <div class:list={['sp-wrap', { partial: s.partial }]}>
                          <img class="viewer-sp" src={asset(s.imageMobile)} alt={`${s.title}のデザイン（スマホ表示）`} loading="lazy" />
                        </div>
                        {s.partial && <p class="partial-note">ページの途中までを掲載しています</p>}
                      </div>
                    )}
                  </div>
                </dialog>
              )}
            </li>
          ))}
        </ul>

        <div class="how">
          <h3 class="how-title">進め方</h3>
          <ol class="how-steps">
            {steps.map((st, i) => (
              <li>
                <span class="how-num" aria-hidden="true">{i + 1}</span>
                <div>
                  <p class="how-step-title">{st.title}</p>
                  <p class="how-step-body">{st.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="how-note">
            デザインにかかる時間を短くできる分、デザイン込みでも費用を抑えられるのが一番のメリットです。ロゴやイラストの制作、ブランドを一から作り込むデザインはお受けしていませんが、まずは手早く形にしたい、予算を抑えたいという方にぴったりです。
          </p>
        </div>
      </div>
    </section>
  )
}

<script>
  import { setupViewSwitch } from '../scripts/viewSwitch';
  setupViewSwitch();
</script>

<style>
  .ai {
    background: var(--ink-soft);
  }
  .samples {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(40px, 5vw, 56px) clamp(24px, 4vw, 40px);
  }
  /* 一覧では「ファーストビュー」だけを見せて、全体はクリックで開く */
  .frames {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: left;
  }
  .frame-pc {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: 0 20px 40px -24px rgb(23 50 74 / 0.4);
  }
  .frame-pc img,
  .frame-sp img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .has-mobile {
    padding-right: 12%;
    padding-bottom: 8%;
  }
  .frame-sp {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24%;
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border-radius: 14px;
    border: 5px solid var(--ink);
    background: var(--surface);
    box-shadow: 0 16px 32px -16px rgb(23 50 74 / 0.5);
  }
  /* スマホ版だけのときは、台紙の上にスマホを置いたように見せる */
  .mobile-only {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-m);
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.7), transparent 60%),
      var(--paper);
    box-shadow: inset 0 0 0 1px rgb(23 50 74 / 0.08);
    overflow: hidden;
  }
  .mobile-only .frame-sp {
    position: static;
    width: auto;
    height: 90%;
    margin-top: 10%;
    aspect-ratio: 9 / 19;
    border-radius: 18px 18px 0 0;
    border-bottom: 0;
    transition: transform 0.4s ease;
  }
  .mobile-only:hover .frame-sp {
    transform: translateY(-4%);
  }
  .frames-hint {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .has-mobile .frames-hint {
    bottom: calc(8% + 12px);
  }
  .frames:hover .frames-hint {
    background: var(--accent);
    color: var(--ink);
  }

  /* 全体表示のダイアログ */
  .viewer {
    width: min(1120px, calc(100% - 24px));
    height: calc(100% - 32px);
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 40px 80px -30px rgb(23 50 74 / 0.5);
  }
  .viewer::backdrop {
    background: rgb(23 50 74 / 0.6);
  }
  .viewer-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .viewer-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 12px 12px 24px;
    border-bottom: 1px solid var(--rule);
  }
  .viewer-title {
    flex: 1;
    min-width: 0;
    font-weight: 700;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .viewer-switch {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--ink-soft);
  }
  .viewer-switch button {
    min-height: 36px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .viewer-switch button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .viewer-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .viewer-close:hover {
    background: var(--ink-soft);
  }
  .viewer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .viewer-body[hidden] {
    display: none;
  }
  .viewer-pc {
    width: 100%;
  }
  .viewer-body-sp {
    padding: 24px 16px;
    background: var(--ink-soft);
  }
  .sp-wrap {
    width: min(390px, 100%);
    margin-inline: auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 32px -16px rgb(23 50 74 / 0.4);
  }
  .sp-wrap.partial {
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 260px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 260px), transparent);
  }
  .viewer-sp {
    width: 100%;
  }
  .partial-note {
    margin-top: 8px;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 24px;
    border: 2px dashed var(--muted);
    border-radius: var(--radius-m);
    background: rgb(255 255 255 / 0.5);
    text-align: center;
    color: var(--muted);
    font-weight: 700;
  }
  .placeholder small {
    display: block;
    margin-top: 8px;
    font-weight: 400;
    font-size: 0.8125rem;
  }
  .sample-body {
    display: grid;
    gap: 6px;
    padding-top: 20px;
  }
  .sample-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .sample-meta .tag {
    background: var(--surface);
  }
  .sample-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--ink);
  }
  .sample-note {
    font-size: 0.9375rem;
  }
  .sample-note.todo {
    padding: 8px 12px;
    border: 1.5px dashed var(--accent);
    border-radius: var(--radius-s);
    background: #fdf8e8;
    font-size: 0.8125rem;
    color: #7a5c00;
  }
  .sample-link {
    justify-self: start;
    font-weight: 700;
    color: var(--ink);
    text-underline-offset: 5px;
  }
  .how {
    margin-top: clamp(56px, 8vw, 88px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: 14px;
    background: var(--surface);
  }
  .how-title {
    margin-bottom: 24px;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
  }
  .how-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .how-steps li {
    display: flex;
    gap: 12px;
  }
  .how-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-latin);
    font-weight: 700;
    line-height: 1;
  }
  .how-step-title {
    font-weight: 700;
    color: var(--ink);
  }
  .how-step-body {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .how-note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .how-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .how-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
